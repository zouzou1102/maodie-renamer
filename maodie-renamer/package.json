{
  "name": "maodie-renamer",
  "version": "1.0.0",
  "description": "耄耋改名（MaoDie Renamer）—— 一只圆头炸毛的耄耋，帮你把文件和文件夹的名字批量改好。完全本地离线。",
  "author": "MaoDie Renamer",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:core": "node tests/run-unit.js tests/p1-rules.test.ts tests/p2a-theme.test.ts tests/p2c.test.ts tests/p2c-guide.test.ts tests/p2b-templates.test.ts tests/p3-1-seq.test.ts tests/p3-2-export.test.ts tests/p3-3-attrs.test.ts tests/p3-4-import.test.ts tests/p3-5-modes.test.ts tests/p3-6-folder.test.ts",
    "lint": "eslint .",
    "cli:verify": "tsx scripts/cli-verify.ts",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "pinia": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^1.6.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
